FROM python:3.9-slim

WORKDIR /app

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements e instalar dependências Python
ENV HF_HOME=/app/.hf

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

RUN python -c "from sentence_transformers import CrossEncoder; CrossEncoder('cross-encoder/mmarco-mMiniLMv2-L12-H384-v1', max_length=512)"

ENV NUMBA_CACHE_DIR=/app/.numba_cache
RUN mkdir -p /app/.numba_cache

# Copiar código da aplicação
COPY src/ ./src/

# Pré-compila os kernels do numba do PyReason com as MESMAS regras e settings
# do app (src/pyreason_engine.py: _rodar_pyreason). O PyReason grava o cache
# em site-packages/pyreason/cache, dentro da imagem: sem este passo, cada
# container recriado recompilava tudo no 1º reason() (~7 min travando o chat).
# O numba invalida o cache se o mtime do .py mudar; o export das camadas
# trunca o mtime para segundos inteiros (1794946061.749 -> 1794946061.0), o que
# invalidava o cache gravado aqui. Normaliza antes de compilar.
RUN find /usr/local/lib/python3.9/site-packages/pyreason -name '*.py' \
        -exec sh -c 'touch -d "@$(stat -c %Y "$1")" "$1"' _ {} \; && \
    python -c "from src.pyreason_engine import aquecer_jit; aquecer_jit()"
COPY graph_viewer.html .
COPY planner.html .
COPY markdown_disciplinas/ ./markdown_disciplinas/
COPY markdown_regimentos/ ./markdown_regimentos/
COPY markdown_docentes/ ./markdown_docentes/
COPY markdown_cursos/ ./markdown_cursos/
COPY jsons_regimentos/ ./jsons_regimentos/
COPY start_api.py .

# Criar diretório para persistência do ChromaDB
RUN mkdir -p ./chroma_db_unifesp

# Variáveis de ambiente
ENV PYTHONUNBUFFERED=1
ENV PYTHONWARNINGS=ignore
# OLLAMA_BASE_URL será definido no docker-compose.yml para usar host.docker.internal

# Expor porta da API
EXPOSE 8000

# Comando para iniciar a API
CMD ["python", "start_api.py"]
