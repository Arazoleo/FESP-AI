FROM python:3.9-slim

WORKDIR /app

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements e instalar dependências Python
ENV HF_HOME=/app/.hf

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

RUN python -c "from sentence_transformers import CrossEncoder; CrossEncoder('cross-encoder/mmarco-mMiniLMv2-L12-H384-v1', max_length=512)"

# Pré-compilar kernels JIT do numba (usado pelo PyReason). Sem isso,
# o primeiro `pr.reason()` paga ~20s no startup do container.
ENV NUMBA_CACHE_DIR=/app/.numba_cache
RUN mkdir -p /app/.numba_cache && \
    python -c "import pyreason as pr; import networkx as nx; g = nx.DiGraph(); g.add_edge('a','b',p=1); pr.load_graph(g); pr.add_rule(pr.Rule('q(x,y) <-1 p(x,y)', 'warm')); pr.reason(timesteps=1); print('numba/pyreason JIT pré-compilado.')"

# Copiar código da aplicação
COPY src/ ./src/
COPY graph_viewer.html .
COPY planner.html .
COPY markdown_disciplinas/ ./markdown_disciplinas/
COPY markdown_regimentos/ ./markdown_regimentos/
COPY markdown_docentes/ ./markdown_docentes/
COPY markdown_cursos/ ./markdown_cursos/
COPY jsons_regimentos/ ./jsons_regimentos/
COPY start_api.py .

# Criar diretório para persistência do ChromaDB
RUN mkdir -p ./chroma_db_unifesp

# Variáveis de ambiente
ENV PYTHONUNBUFFERED=1
ENV PYTHONWARNINGS=ignore
# OLLAMA_BASE_URL será definido no docker-compose.yml para usar host.docker.internal

# Expor porta da API
EXPOSE 8000

# Comando para iniciar a API
CMD ["python", "start_api.py"]
