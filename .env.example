# Copie para .env e ajuste se quiser:
#   cp .env.example .env
#
# Modelo na nuvem Ollama (roda no Ollama local, mas o modelo é offload para nuvem).
# Antes de subir o backend: ollama signin && ollama pull <modelo>
# Depois: docker compose up -d
MODEL_NAME=gpt-oss:120b-cloud

# Alternativas cloud (veja OLLAMA_CLOUD.md):
#   qwen3.5:cloud          ou  qwen3.5:397b-cloud
#   qwen3-next:80b-cloud
#   deepseek-v3.2:cloud
#   minimax-m2.5:cloud
#   kimi-k2.5:cloud

# Opcional: manter o modelo local em vez do cloud
# MODEL_NAME=ministral-3:8b

# URL do Ollama (deixe como está para Ollama local + modelos cloud)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
