# ── FESP-AI: configuração ──
# Copie para .env e ajuste:
#   cp .env.example .env
# Depois: docker compose up -d

# LLM de geração (Ollama): local ou cloud
# Para modelos cloud: ollama signin && ollama pull <modelo> (veja OLLAMA_CLOUD.md)
# MODEL_NAME=gemma4:31b-cloud
# MODEL_NAME=deepseek-r1:7b
# MODEL_NAME=qwen3.5:cloud

# Embeddings (troca segura: o sync detecta a dimensão e reconstrói a collection)
# EMBEDDING_MODEL=embeddinggemma
# EMBEDDING_MODEL=mxbai-embed-large   # 1024d, forte em inglês (baseline anterior)
# EMBEDDING_MODEL=bge-m3              # multilíngue (ollama pull bge-m3)

# URL do Ollama (deixe como está para Ollama local + modelos cloud)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Humanizar respostas do Knowledge Graph (tom conversacional; fatos preservados)
# FESPAI_HUMANIZE_KG=1

# Motor de inferência simbólica: pyreason (padrão) ou python
# FESPAI_REASONER=python

# Validação de claims via LLM (0 desliga; padrão ligado)
# FESPAI_CLAIM_CHECK=0
